{
  "name": "ctm",
  "version": "0.3.0",
  "description": "Claude Terminal Multiplexer — 用 ConPTY 托管 Claude Code 交互式会话，让多个会话互通、分组隔离、按需拉起",
  "type": "module",
  "bin": {
    "ctm": "src/main.mjs"
  },
  "files": [
    ".claude-plugin",
    ".mcp.json",
    "commands",
    "docs",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "doctor": "node src/main.mjs doctor",
    "test": "node test/unit-tui.mjs && node test/unit-inbox.mjs && node test/unit-launch.mjs && node test/unit-groups.mjs && node test/unit-resolve.mjs && node test/unit-rooms.mjs && node test/unit-mcp.mjs",
    "test:smoke": "node test/m1-smoke.mjs",
    "test:m2": "node test/m2-delivery.mjs",
    "test:m3": "node test/m3-lazy-launch.mjs",
    "test:m4": "node test/m4-wrap.mjs",
    "test:m5": "node test/m5-permission.mjs",
    "prepack": "npm test"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "multiplexer",
    "sessions",
    "messaging",
    "pty",
    "conpty"
  ],
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "license": "MIT"
}
